videos/productions/openai-dots-news/quality-review/rough*/no-captions/
videos/productions/openai-dots-news/quality-review/rough*/evidence-*/
videos/productions/openai-dots-news/quality-review/rough*/gold-*/

# Retained draft calibration attempts contain private external evidence.
videos/productions/*/private-calibration-history/

# Turbo R&D: private review evidence and isolated tooling.
.venv/
.test-tools/
private-audit/
videos/productions/turbo-*/**/*-input.txt
videos/productions/turbo-*/**/*-events.jsonl
videos/productions/turbo-*/**/*-stderr.txt
