{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Atelier film manifest: the deterministic playback entrypoint",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "entry",
  "fps",
  "frames",
  "design",
  "shots",
  "moments",
  "proof",
  "sound"
 ],
 "properties": {
  "entry": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_./-]+\\.js$"
  },
  "fps": {
   "enum": [
    24,
    25,
    30
   ]
  },
  "frames": {
   "type": "integer",
   "minimum": 12,
   "maximum": 3600
  },
  "design": {
   "type": "array",
   "prefixItems": [
    {
     "const": 1080
    },
    {
     "const": 1920
    }
   ],
   "items": false,
   "minItems": 2
  },
  "fonts": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "family",
     "path"
    ],
    "properties": {
     "family": {
      "type": "string",
      "minLength": 3
     },
     "path": {
      "type": "string",
      "minLength": 3
     },
     "weight": {
      "type": "integer"
     }
    }
   }
  },
  "images": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "shots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "start",
     "end"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
     },
     "start": {
      "type": "integer",
      "minimum": 0
     },
     "end": {
      "type": "integer",
      "minimum": 1
     },
     "note": {
      "type": "string",
      "minLength": 3
     }
    }
   }
  },
  "moments": {
   "type": "object",
   "additionalProperties": {
    "type": "integer",
    "minimum": 0
   }
  },
  "key_moments": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "moments reviewers get dense strips for (default: all)"
  },
  "proof": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "shot",
    "start",
    "end"
   ],
   "properties": {
    "shot": {
     "type": "string",
     "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "start": {
     "type": "integer",
     "minimum": 0
    },
    "end": {
     "type": "integer",
     "minimum": 1
    },
    "note": {
     "type": "string",
     "minLength": 3
    }
   }
  },
  "sound": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "narration",
    "sfx",
    "music"
   ],
   "properties": {
    "voice": {
     "type": [
      "string",
      "null"
     ]
    },
    "speed": {
     "type": "number",
     "minimum": 0.8,
     "maximum": 1.2
    },
    "narration": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "text",
       "at"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
       },
       "text": {
        "type": "string",
        "minLength": 12
       },
       "at": {
        "oneOf": [
         {
          "type": "integer",
          "minimum": 0
         },
         {
          "type": "string"
         }
        ]
       },
       "ends_before": {
        "oneOf": [
         {
          "type": "integer",
          "minimum": 0
         },
         {
          "type": "string"
         }
        ]
       },
       "claims": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
       }
      }
     }
    },
    "sfx": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "at"
      ],
      "properties": {
       "at": {
        "oneOf": [
         {
          "type": "integer",
          "minimum": 0
         },
         {
          "type": "string"
         }
        ]
       },
       "offset": {
        "type": "integer"
       },
       "recipe": {
        "type": "string",
        "minLength": 3
       },
       "file": {
        "type": "string",
        "minLength": 3
       },
       "gain_db": {
        "type": "number",
        "minimum": -60,
        "maximum": 6
       },
       "params": {
        "type": "object"
       },
       "seed": {
        "type": "integer"
       },
       "pan": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
       },
       "note": {
        "type": "string",
        "minLength": 3
       }
      }
     }
    },
    "music": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind"
     ],
     "properties": {
      "kind": {
       "enum": [
        "none",
        "notes"
       ]
      },
      "tempo": {
       "type": "number",
       "minimum": 40,
       "maximum": 220
      },
      "gain_db": {
       "type": "number",
       "minimum": -60,
       "maximum": 0
      },
      "duck_db": {
       "type": "number",
       "minimum": 0,
       "maximum": 30
      },
      "tracks": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "instrument",
         "notes"
        ],
        "properties": {
         "instrument": {
          "enum": [
           "pluck",
           "pizz",
           "marimba",
           "bell",
           "pad",
           "bass",
           "celesta",
           "drum"
          ]
         },
         "gain_db": {
          "type": "number",
          "minimum": -60,
          "maximum": 6
         },
         "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
         },
         "notes": {
          "type": "array",
          "items": {
           "type": "array",
           "prefixItems": [
            {
             "type": "number",
             "minimum": 0
            },
            {
             "type": "integer",
             "minimum": 0,
             "maximum": 127
            },
            {
             "type": "number",
             "exclusiveMinimum": 0
            },
            {
             "type": "number",
             "minimum": 0,
             "maximum": 1
            }
           ],
           "minItems": 4,
           "items": false
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
