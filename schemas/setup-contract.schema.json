{
  "type": "object",
  "properties": {
    "setup_id": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "type": "string",
      "minLength": 1
    },
    "narration_span": {
      "type": "object",
      "properties": {
        "start_word": {
          "type": "integer",
          "minimum": 0
        },
        "end_word": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start_word",
        "end_word",
        "text"
      ],
      "additionalProperties": false
    },
    "semantic_center": {
      "type": "string",
      "minLength": 1
    },
    "visual_rule": {
      "type": "string",
      "minLength": 1
    },
    "relationship_archetype": {
      "type": "string",
      "minLength": 1
    },
    "hero": {
      "type": "string",
      "minLength": 1
    },
    "bot_role": {
      "type": "string",
      "enum": [
        "participant",
        "reactor",
        "presenter",
        "absent"
      ]
    },
    "continuity_tokens": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment_mode": {
      "type": "string",
      "enum": [
        "physical",
        "minimal-isolated"
      ]
    },
    "palette_family": {
      "type": "string",
      "minLength": 1
    },
    "entry_state": {
      "type": "string",
      "minLength": 1
    },
    "exit_state": {
      "type": "string",
      "minLength": 1
    },
    "reason_for_persistence": {
      "type": "string",
      "minLength": 1
    },
    "planned_reset_after": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "hard-cut",
            "object-led",
            "match-movement",
            "lateral-push",
            "end"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    },
    "beat_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "setup_id",
    "chapter",
    "narration_span",
    "semantic_center",
    "visual_rule",
    "relationship_archetype",
    "hero",
    "bot_role",
    "continuity_tokens",
    "environment_mode",
    "palette_family",
    "entry_state",
    "exit_state",
    "reason_for_persistence",
    "planned_reset_after",
    "beat_ids"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
