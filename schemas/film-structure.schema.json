            "type": "string",
            "minLength": 1
          },
          "visual_rule": {
            "type": "string",
            "minLength": 1
          },
          "relationship_archetype": {
            "type": "string",
            "minLength": 1
          },
          "hero": {
            "type": "string",
            "minLength": 1
          },
          "bot_role": {
            "type": "string",
