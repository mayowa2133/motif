          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "narration_span": {
            "type": "object",
            "properties": {
              "start_word": {
                "type": "integer",
                "minimum": 0
              },
              "end_word": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "start_word",
              "end_word",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "purpose",
          "narration_span"
        ],
        "additionalProperties": false
      }
    },
    "setups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
