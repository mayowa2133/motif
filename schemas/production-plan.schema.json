      "then": {
        "properties": {
          "beats": {
            "items": {
              "required": [
                "quality"
              ]
            }
          }
        },
        "required": [
          "asset_usage"
        ]
      }
    },
    {
      "if": {
        "required": [
          "film_structure"
        ]
      },
      "then": {
        "required": [
          "quality_mode"
        ]
      }
    }
  ]
