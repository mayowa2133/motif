{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motif.local/schemas/reel-brief.schema.json",
  "title": "Motif reel brief (script, fact packet, optional visual hints)",
  "type": "object",
  "required": [
    "slug",
    "title",
    "topic",
    "facts",
    "beats",
    "cta"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,60}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "topic": {
      "type": "string",
      "minLength": 3
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "voice": {
      "type": "string",
      "default": "af_nova"
    },
    "hook": {
      "type": "object",
      "properties": {
        "alternates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8
          },
          "minItems": 1,
          "maxItems": 5
        },
        "selected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "headline": {
          "type": "string",
          "maxLength": 34
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "description": "The hook's own machine (otherwise the hook opens on the first claim's machine).",
          "properties": {
            "rig": {
              "type": "string"
            },
            "params": {
              "type": "object"
            },
            "room": {
              "type": "string"
            },
            "palette": {
              "type": "string"
            }
          },
          "required": [
            "rig"
          ]
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source_url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "accessed": {
            "type": "string"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "narration",
          "fact"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "narration": {
            "type": "string",
            "minLength": 8
          },
          "fact": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "maxLength": 34
          },
          "payoff_headline": {
            "type": "string",
            "maxLength": 34
          },
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rig": {
                "type": "string"
              },
              "params": {
                "type": "object"
              },
              "room": {
                "type": "string"
              },
              "insert": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "args": {
                    "type": "object"
                  }
                }
              },
              "costume": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "palette": {
                "type": "string"
              },
              "hold": {
                "type": "boolean",
                "description": "Keep the machine in its start state through the beat; a later beat shows the change."
              },
              "brand": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "This beat's product mark when it differs from the film's (null: none)."
              }
            }
          },
          "relation": {
            "type": "string",
            "description": "Shape of the claim (motif_semantics.RELATIONS); the machine must show it.",
            "enum": [
              "over-capacity",
              "pile-up",
              "cost-crush",
              "race",
              "trade-off",
              "big-number",
              "level",
              "approve",
              "transform",
              "spread",
              "attract",
              "launch",
              "unlock",
              "grow",
              "connect",
              "everywhere",
              "demo"
            ]
          }
        }
      },
      "description": "4 to 6 beats for the short format, up to 10 for the long format"
    },
    "cta": {
      "type": "object",
      "required": [
        "keyword",
        "narration"
      ],
      "additionalProperties": false,
      "properties": {
        "keyword": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{2,16}$"
        },
        "narration": {
          "type": "string"
        },
        "room": {
          "type": "string"
        }
      }
    },
    "look": {
      "type": "string",
      "enum": [
        "paper-craft",
        "neon-arcade",
        "primary-pop",
        "candy-pastel",
        "great-outdoors"
      ],
      "description": "Per-film look (scripts/motif_looks.py). Omitted: the planner picks one not used by recent films."
    },
    "brand": {
      "type": "object",
      "required": [
        "slug"
      ],
      "additionalProperties": false,
      "description": "The product the reel is about; its mark (vendored in assets/brands) appears on the hook, on each machine and on the end card.",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "format": {
      "type": "string",
      "enum": [
        "short",
        "long"
      ],
      "default": "short",
      "description": "short: 20-32 s, 4-6 beats (the benchmark format). long: 30-62 s, 4-10 beats, for adaptations and how-tos."
    }
  }
}
