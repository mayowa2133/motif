{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motif.local/schemas/reel-brief.schema.json",
  "title": "Motif reel brief (script, fact packet, optional visual hints)",
  "type": "object",
  "required": [
    "slug",
    "title",
    "topic",
    "facts",
    "beats",
    "cta"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,60}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "topic": {
      "type": "string",
      "minLength": 3
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "voice": {
      "type": "string",
      "description": "Kokoro voice. Approved: af_heart, af_bella, bf_emma (default: picked from these by seed); af_nova was the original voice."
    },
    "hook": {
      "type": "object",
      "properties": {
        "alternates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8
          },
          "minItems": 1,
          "maxItems": 5
        },
        "selected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "headline": {
          "type": "string",
          "maxLength": 34
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "description": "The hook's own machine (otherwise the hook opens on the first claim's machine).",
          "properties": {
            "rig": {
              "type": "string"
            },
            "params": {
              "type": "object"
            },
            "room": {
              "type": "string"
            },
            "palette": {
              "type": "string"
            },
            "brand": {
              "type": [
                "string",
                "null"
              ],
              "description": "The hook's product mark when it differs from the film's (null: none, e.g. a hook about the problem before the product)."
            },
            "framing": {
              "enum": [
                "wide",
                "close"
              ],
              "description": "close: the hook opens big on the acting part (a product screen); default wide."
            }
          },
          "required": [
            "rig"
          ]
        },
        "headline_b": {
          "type": "string",
          "maxLength": 30,
          "description": "Second headline for this long shot (otherwise the planner cuts one from the narration at a clause boundary)."
        },
        "story": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "promise",
            "sets_up"
          ],
          "properties": {
            "promise": {
              "type": "string",
              "maxLength": 120,
              "description": "What the first seconds promise the viewer will see; the last beat or CTA must keep it."
            },
            "sets_up": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "uniqueItems": true,
              "description": "Details this part introduces that a later beat or the CTA must pay off (short kebab tokens)."
            },
            "pays_off": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "uniqueItems": true,
              "description": "Tokens set up earlier (by the hook or an earlier beat) that this part develops or resolves on screen."
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "source_url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "accessed": {
            "type": "string"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "narration",
          "fact"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "narration": {
            "type": "string",
            "minLength": 8
          },
          "fact": {
            "type": "string"
          },
          "headline": {
            "type": "string",
            "maxLength": 34
          },
          "payoff_headline": {
            "type": "string",
            "maxLength": 34
          },
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rig": {
                "type": "string"
              },
              "params": {
                "type": "object"
              },
              "room": {
                "type": "string"
              },
              "insert": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "args": {
                    "type": "object"
                  }
                }
              },
              "costume": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "palette": {
                "type": "string"
              },
              "framing": {
                "enum": [
                  "wide",
                  "close"
                ],
                "description": "close: the camera holds in on the acting part (Rig.focus close) and the host stands small in front; default close on app-screen, wide elsewhere."
              },
              "hold": {
                "type": "boolean",
                "description": "Keep the machine in its start state through the beat; a later beat shows the change."
              },
              "brand": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "This beat's product mark when it differs from the film's (null: none)."
              },
              "act": {
                "enum": [
                  "cheers",
                  "gasps",
                  "inspects",
                  "shrugs",
                  "smug",
                  "stamps",
                  "types"
                ],
                "description": "The host's act this beat (motif_acts): how it works the machine, hits on the contact and reacts. Default: by relation."
              },
              "entrance": {
                "enum": [
                  "walk",
                  "pop",
                  "drop",
                  "slide"
                ],
                "description": "How the host arrives in the set. Default: rotates by beat."
              }
            }
          },
          "relation": {
            "type": "string",
            "description": "Shape of the claim (motif_semantics.RELATIONS); the machine must show it.",
            "enum": [
              "over-capacity",
              "pile-up",
              "cost-crush",
              "race",
              "trade-off",
              "big-number",
              "level",
              "approve",
              "transform",
              "spread",
              "attract",
              "launch",
              "unlock",
              "grow",
              "connect",
              "everywhere",
              "demo"
            ]
          },
          "story": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "purpose",
              "link",
              "before",
              "after",
              "action"
            ],
            "description": "Story pass (docs/STORY_PASS.md): what this beat does to the story and how the viewer sees it.",
            "properties": {
              "purpose": {
                "enum": [
                  "complicate",
                  "demonstrate",
                  "reveal",
                  "escalate",
                  "resolve"
                ],
                "description": "What the beat does: complicate (a problem gets worse), demonstrate (the claim happens on screen), reveal (the turn: the viewer learns the truth), escalate (stakes or scale grow), resolve (the promise is kept)."
              },
              "link": {
                "enum": [
                  "but",
                  "therefore"
                ],
                "description": "How this beat follows the previous one. 'and then' is not allowed: if neither word fits, the beat is a list item, not a story beat."
              },
              "before": {
                "type": "string",
                "maxLength": 80,
                "description": "What the object looks like when the beat starts."
              },
              "after": {
                "type": "string",
                "maxLength": 80,
                "description": "What it looks like when the beat ends. Must use words that appear on screen (headline, payoff headline, machine labels or screen lines)."
              },
              "action": {
                "type": "string",
                "maxLength": 80,
                "description": "The one physical action that makes the change (who does what to what)."
              },
              "line_job": {
                "enum": [
                  "context",
                  "anticipation",
                  "explain",
                  "land"
                ],
                "description": "Narration's job: context, anticipation (opens a question), explain (says what the picture cannot), land (the line people would repeat)."
              },
              "sets_up": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "uniqueItems": true,
                "description": "Details this part introduces that a later beat or the CTA must pay off (short kebab tokens)."
              },
              "pays_off": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "uniqueItems": true,
                "description": "Tokens set up earlier (by the hook or an earlier beat) that this part develops or resolves on screen."
              }
            }
          }
        }
      },
      "description": "4 to 6 beats for the short format, up to 10 for the long format"
    },
    "cta": {
      "type": "object",
      "required": [
        "keyword",
        "narration"
      ],
      "additionalProperties": false,
      "properties": {
        "keyword": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{2,16}$"
        },
        "narration": {
          "type": "string"
        },
        "room": {
          "type": "string"
        },
        "headline_b": {
          "type": "string",
          "maxLength": 30,
          "description": "Second headline for this long shot (otherwise the planner cuts one from the narration at a clause boundary)."
        },
        "story": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sets_up": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "uniqueItems": true,
              "description": "Details this part introduces that a later beat or the CTA must pay off (short kebab tokens)."
            },
            "pays_off": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "uniqueItems": true,
              "description": "Tokens set up earlier (by the hook or an earlier beat) that this part develops or resolves on screen."
            },
            "line_job": {
              "enum": [
                "context",
                "anticipation",
                "explain",
                "land"
              ],
              "description": "Narration's job: context, anticipation (opens a question), explain (says what the picture cannot), land (the line people would repeat)."
            }
          }
        }
      }
    },
    "look": {
      "type": "string",
      "enum": [
        "paper-craft",
        "neon-arcade",
        "primary-pop",
        "candy-pastel",
        "great-outdoors"
      ],
      "description": "Per-film look (scripts/motif_looks.py). Omitted: the planner picks one not used by recent films."
    },
    "brand": {
      "type": "object",
      "required": [
        "slug"
      ],
      "additionalProperties": false,
      "description": "The product the reel is about; its mark (vendored in assets/brands) appears on the hook, on each machine and on the end card.",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        }
      }
    },
    "format": {
      "type": "string",
      "enum": [
        "short",
        "long"
      ],
      "default": "short",
      "description": "short: 20-32 s, 4-6 beats (the benchmark format). long: 30-62 s, 4-10 beats, for adaptations and how-tos."
    },
    "mascot": {
      "type": "string",
      "enum": [
        "bot",
        "kit",
        "memo",
        "lumo"
      ],
      "default": "bot",
      "description": "The film's host character (scripts/motif_mascots.py). Same poses, cycles, faces and costumes as Bot."
    },
    "carry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 14
        }
      },
      "description": "The film's one object, carried by the host through every set as a labelled card and thrown into the product screens (AGENTS.md: story first)."
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "premises",
        "chosen",
        "object",
        "ending"
      ],
      "description": "Story pass, written before the beats (docs/STORY_PASS.md).",
      "properties": {
        "premises": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "maxLength": 240
          },
          "description": "At least three different premises (one object, one want, one obstacle, one visible ending each); the obvious first idea goes first."
        },
        "chosen": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of the premise this film tells, and why in 'why'."
        },
        "why": {
          "type": "string",
          "maxLength": 240
        },
        "object": {
          "type": "string",
          "maxLength": 60,
          "description": "The one object that changes through the film."
        },
        "spine": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional story spine: Every day... One day... Because of that... Until finally..."
        },
        "ending": {
          "type": "string",
          "maxLength": 160,
          "description": "The final picture: what the viewer sees that keeps the hook's promise. Written before the middle."
        }
      }
    }
  }
}
